# AsmBlog Site Configuration Template
# Copy this file to site/config.ini and customize your anime blog!

site_name = SkyRibbon Blog
subtitle = Pure x86-64 Assembly Anime Static Blog ✦
site_url = https://your-domain.example
author = Sakura
footer_text = Made with ♡ · Powered by Pure x86-64 Assembly

# Custom avatar (1:1) and hero banner (16:9) — can also be uploaded & cropped inside Author Studio
avatar_url = /static/avatar.jpg?v=2
banner_url = /static/hero-banner.jpg?v=2

# HTTP listen port (use 8080 when running behind Caddy/Nginx HTTPS reverse proxy)
port = 8080
per_page = 6
theme = sky-ribbon
dist_dir = dist

# Hidden Author Studio (not linked anywhere on the public frontend)
# Customize studio_path (e.g. /my-secret-room) to hide the default /studio URL
studio_path = /studio

# Generate with: ./asmblog hash-pass "your-strong-passphrase"
# Leave empty to completely disable Author Studio in pure read-only mode
studio_pass_sha256 =
